{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "OpenApi": {
    "Enabled": true
  },
  "Auth": {
    "ApiKeys": [
      "dev-only-key-not-a-secret"
    ]
  }
}
